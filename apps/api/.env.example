# Supabase project that holds the Groundwork data (RPCs app_get_data, app_get_jobs, ...)
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_KEY=<anon / publishable key>
# Row key in the app_access table (the RPCs check its hash)
APP_KEY=<app key>
# bcrypt hash of the dashboard password (PHP password_hash output also works)
PASSWORD_HASH=<bcrypt hash>
# Long random string used to sign login tokens
JWT_SECRET=<random>
# Comma separated browser origins allowed to call the API
CORS_ORIGINS=https://groundwork.viagradient.com
# Seconds to cache Supabase responses (default 300)
CACHE_TTL=300
# Local testing only: read <name>.json fixtures from this directory instead of Supabase
# FIXTURE_DIR=./fixtures
