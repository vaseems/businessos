{
  "name": "groundwork-api",
  "version": "1.0.0",
  "private": true,
  "description": "Groundwork API (NestJS) - serves the Groundwork dashboard from Supabase",
  "scripts": {
    "build": "nest build",
    "start": "node dist/app.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "typescript": "~5.8.0"
  }
}
